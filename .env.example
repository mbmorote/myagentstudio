ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Second LLM provider — OpenAI-compatible endpoint (Plan 11).
# Any vendor that speaks the /v1/chat/completions wire format is supported:
# NVIDIA NIM, OpenAI, Groq, Together, OpenRouter, DeepSeek, Mistral, vLLM, Ollama, etc.
# All three vars are required together; an absent key or base URL disables the provider.
# Switch between providers from System Settings (admin only) — no restart needed.
#
# NVIDIA NIM example:
#   OPENAI_COMPATIBLE_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_COMPATIBLE_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
#
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Auth — required; must be ≥ 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Session lifetime in seconds — optional, default 604800 (7 days).
# Must be an integer between 60 and 7776000 (90 days); an out-of-range value
# prevents the server from starting. Affects only tokens issued after a restart —
# existing sessions keep their original exp. To immediately invalidate all
# sessions, rotate JWT_SECRET instead.
# SESSION_TTL_SECONDS=604800

# Google OAuth 2.0 / OpenID Connect — optional, all-or-nothing (Plan 06 §3.4).
# If any one of these is set, all three must be set; a partial config prevents the
# server from starting. If none is set, OAuth is disabled and password auth still works.
#
# Register a client at https://console.cloud.google.com/apis/credentials.
# Redirect URI to register: ${OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/google/callback
#
# GOOGLE_CLIENT_ID=…apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=…
# OAUTH_REDIRECT_BASE_URL=http://localhost:3000   # scheme+host+port only, no trailing slash
#                                                  # must be https in production

# Bootstrap admin credentials — only read by `npm run auth:bootstrap`.
# Set these in a shell var at the time you run the command, not permanently here:
#   BOOTSTRAP_USER_EMAIL=you@example.com BOOTSTRAP_USER_PASSWORD='...' npm run auth:bootstrap
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=

# /welcome footer author identity line (Plan 12) — optional. NEXT_PUBLIC_ because it's
# rendered on the public pre-login landing page, not a secret. Unset falls back to a
# visible placeholder rather than a broken link.
# NEXT_PUBLIC_AUTHOR_NAME=
# NEXT_PUBLIC_AUTHOR_LINKEDIN=https://linkedin.com/in/…
# NEXT_PUBLIC_AUTHOR_GITHUB=https://github.com/…
# NEXT_PUBLIC_AUTHOR_EMAIL=mailto:you@example.com
