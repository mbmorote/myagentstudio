ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Second LLM provider — OpenAI-compatible endpoint (Plan 11).
# Any vendor that speaks the OpenAI chat-completions wire format is supported:
# NVIDIA NIM, OpenAI, Groq, Together, OpenRouter, DeepSeek, Mistral, vLLM, Ollama, etc.
# All three vars are required together; an absent key or base URL disables the provider.
# Switch between providers from System Settings (admin only) — no restart needed
# (changing these env vars themselves still needs a restart, since Next.js only
# reads .env.local at process start).
#
# BASE_URL must include the vendor's own version segment (e.g. NVIDIA/OpenAI/Groq
# all document their base_url ending in /v1) — the provider appends /chat/completions
# to whatever you give it, it does not add /v1 itself (fixed 2026-08-20; an earlier
# version double-appended /v1 and 404'd on every call).
#
# NVIDIA NIM — live-verified 2026-08-20 against a real account. Being LISTED in
# NVIDIA's /v1/models catalog does not mean a model is actually CALLABLE — some
# (e.g. the Nemotron-70B example this file used to recommend) 404 with "Function
# not found for account" even though they're listed, gated behind an account-level
# "Public API Endpoints" permission NVIDIA enables per-model/per-account. Confirmed
# working with a personal free-tier key, in increasing per-call cost:
#   - meta/llama-3.1-8b-instruct            — fastest/cheapest, no reasoning overhead (recommended default)
#   - openai/gpt-oss-20b                    — moderate reasoning overhead (~60 tokens before the real answer)
#   - nvidia/nemotron-3.5-lightning-30b-a3b — NVIDIA's own reasoning model; ~200+ tokens of
#                                              reasoning_content before the real answer, so give it
#                                              generous max_tokens headroom or it truncates mid-thought
# Confirmed NOT working on a free-tier key: mistralai/mistral-7b-instruct-v0.3 (404,
# same account-gating issue), meta/llama-3.3-70b-instruct (504 Gateway Timeout after
# ~2 minutes — unreliable regardless of gating).
#
# NVIDIA NIM example:
#   OPENAI_COMPATIBLE_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_COMPATIBLE_MODEL=meta/llama-3.1-8b-instruct
#
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=meta/llama-3.1-8b-instruct

# Auth — required; must be ≥ 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Session lifetime in seconds — optional, default 604800 (7 days).
# Must be an integer between 60 and 7776000 (90 days); an out-of-range value
# prevents the server from starting. Affects only tokens issued after a restart —
# existing sessions keep their original exp. To immediately invalidate all
# sessions, rotate JWT_SECRET instead.
# SESSION_TTL_SECONDS=604800

# Google OAuth 2.0 / OpenID Connect — optional, all-or-nothing (Plan 06 §3.4).
# If any one of these is set, all three must be set; a partial config prevents the
# server from starting. If none is set, OAuth is disabled and password auth still works.
#
# Register a client at https://console.cloud.google.com/apis/credentials.
# Redirect URI to register: ${OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/google/callback
#
# GOOGLE_CLIENT_ID=…apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=…
# OAUTH_REDIRECT_BASE_URL=http://localhost:3000   # scheme+host+port only, no trailing slash
#                                                  # must be https in production

# Email — Resend (Plan 14) — optional, all-or-nothing for the first three vars.
# None set → email disabled, the app behaves exactly as before email existed (invite codes
# are copied and sent by hand). Some but not all set → refuses to boot.
#
# 1. Create an account at resend.com, add your sending domain, and publish the SPF/DKIM
#    (and recommended DMARC) DNS records it gives you. Disable open/click tracking in the
#    dashboard — this app is transactional-only.
# 2. Create an API key scoped to sending only.
#
# RESEND_API_KEY=
# EMAIL_FROM=MyAgentStudio <noreply@yourdomain.com>
# APP_BASE_URL=https://yourdomain.com   # scheme+host+optional-port only, no trailing slash
#                                        # must be https in production; used to build links in emails
#
# Optional, independent of the group above:
# EMAIL_REPLY_TO=support@yourdomain.com          # absent → no Reply-To header is sent
# ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com  # absent → no notice on a new access request

# Bootstrap admin credentials — only read by `npm run auth:bootstrap`.
# Set these in a shell var at the time you run the command, not permanently here:
#   BOOTSTRAP_USER_EMAIL=you@example.com BOOTSTRAP_USER_PASSWORD='...' npm run auth:bootstrap
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=

# /welcome footer author identity line (Plan 12) — optional. NEXT_PUBLIC_ because it's
# rendered on the public pre-login landing page, not a secret. Unset falls back to a
# visible placeholder rather than a broken link.
# NEXT_PUBLIC_AUTHOR_NAME=
# NEXT_PUBLIC_AUTHOR_LINKEDIN=https://linkedin.com/in/…
# NEXT_PUBLIC_AUTHOR_GITHUB=https://github.com/…
# NEXT_PUBLIC_AUTHOR_EMAIL=mailto:you@example.com

# /privacy and /terms "Who We Are" legal-entity disclosure — optional. Unset falls back
# to a generic (still accurate) statement naming only ProcessMind Solutions, no
# individual or registration number. Set both together for the full DBA-style
# disclosure; a real-world equivalent is CNPJ, adapt to your own jurisdiction.
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=
# NEXT_PUBLIC_LEGAL_ENTITY_CNPJ=
